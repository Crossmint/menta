# Copy to apps/web/.env.local. `pnpm dev` loads it for both Next and the Eve agent.
# REQUIRED values must be set for the app to run; everything else is optional.
# Never commit real values. See docs/CREDENTIALS.md for where each one comes from.

# REQUIRED. Exact public origin, no trailing slash.
OCA_WEB_ORIGIN=http://localhost:3000

# Stytch Consumer project (web login).
# REQUIRED.
STYTCH_PROJECT_ID=
# REQUIRED. Also derives the keys that seal stored secrets: keep it stable.
STYTCH_SECRET=
# Optional: enables Google sign-in (email login works without it).
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=
# Optional: prefix of the custom HTML templates for the sign-in code email, e.g. menta-code
# (needs Stytch's custom email add-on). Unset: Stytch's default email.
OCA_CODE_EMAIL_TEMPLATES=

# Optional: PostHog product analytics, after cookie consent (pageviews and clicks; no session replay). Unset: off, no banner.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional: PostHog ingestion host. Default https://us.i.posthog.com (EU: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=

# REQUIRED. Neon Postgres: conversation owners, saved defaults, MCP state. Run `pnpm db:migrate` once.
# `pnpm dev` also keeps Eve's Workflow state here (its own schemas, set up on start).
DATABASE_URL=

# REQUIRED locally (on Vercel, the project's OIDC token works instead). Vercel AI Gateway;
# the model is set in packages/agent/agent/agent.ts.
AI_GATEWAY_API_KEY=

# Crossmint. Agent Checkouts is production-only, so production keys are REQUIRED.
# The project's JWT authentication must accept Stytch session JWTs (3P provider: Stytch).
# Optional: production (default) or staging; picks the key pair below.
CROSSMINT_ENV=production
# REQUIRED.
CROSSMINT_PRODUCTION_SERVER_API_KEY=
# REQUIRED.
CROSSMINT_PRODUCTION_CLIENT_API_KEY=
# Optional: only read when CROSSMINT_ENV=staging.
CROSSMINT_STAGING_SERVER_API_KEY=
CROSSMINT_STAGING_CLIENT_API_KEY=

# MCP server at {OCA_WEB_ORIGIN}/mcp (Stytch Connected Apps).
# Optional: the Stytch project domain, e.g. https://<slug>.customers.stytch.com.
# Empty: OAuth tokens are rejected (MCP clients can't connect).
OCA_MCP_AUTHORIZATION_SERVER_URL=
# Optional (defaults: commerce:invoke, 28800 seconds, Stytch's 8-hour access tokens).
OCA_MCP_SCOPES=
OCA_MCP_MAX_TOKEN_LIFETIME_SECONDS=
# Optional: `off` turns off MCP Events (checkout notifications to ChatGPT by webhook).
OCA_MCP_EVENTS=

# Optional: Crossmint's payment approval and private fields inside the ChatGPT/Claude card,
# via a Stytch Trusted Auth Token profile. Unset: the card links to the secure page.
OCA_MCP_CARD_TOKEN_PROFILE_ID=
# PKCS#8 PEM, newlines as \n.
OCA_MCP_CARD_TOKEN_PRIVATE_KEY=

# Optional desktop Web Push, generated once with `pnpm --filter @oca/agent exec web-push generate-vapid-keys`.
# Keep the private key secret; use the same pair across deployments.
OCA_PUSH_PUBLIC_KEY=
OCA_PUSH_PRIVATE_KEY=

# Optional Grok Bot updates. `off` turns them off; OCA_GROK_BOT_WATCH=rearm lets followers
# re-arm past one request (keeps a function running up to 30 minutes per watched checkout).
OCA_GROK_BOT_UPDATES=
OCA_GROK_BOT_WATCH=

# Development and tests only. Leave commented out unless you need them.
# Ports for `pnpm dev` (defaults 3000 and 4357).
# PORT=3000
# EVE_PORT=4357
# Eve's Workflow world for `pnpm dev`: postgres (default with DATABASE_URL) or local.
# OCA_DEV_WORKFLOW_WORLD=local
# Postgres Workflow world overrides (defaults: DATABASE_URL's direct endpoint, 10 workers, pool of 12).
# WORKFLOW_POSTGRES_URL=
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10
# WORKFLOW_POSTGRES_MAX_POOL_SIZE=12
# A throwaway database for the *.db.test.ts suites (never a shared one); unset, they skip.
# OCA_TEST_DATABASE_URL=
